{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kernel-bug-benchmark/metadata.schema.json",
  "title": "Kernel bug benchmark task metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "config_required"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "config_required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CONFIG_[A-Z0-9_]+=.+$"
      }
    }
  }
}
